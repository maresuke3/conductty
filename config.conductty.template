# conductty 設定ファイルテンプレート
# このファイルを config.conductty（または OS 専用ファイル名）にコピーして配置してください。
#
# 配置優先順位（各ディレクトリで OS 専用ファイルを優先。見つかった場合は config.conductty は読まない）:
#   macOS  : macos.conductty -> config.conductty
#   Windows: windows.conductty -> config.conductty
#   Linux  : linux.conductty -> config.conductty
#   WSL    : wsl.conductty -> linux.conductty -> config.conductty
# 探索ディレクトリ順:
#   1. ~/.config/conductty/
#   2. ~/.config/
#   3. ~/.conductty/
#   4. ~/ (ドットファイル: ~/.macos.conductty, ~/.config.conductty 等)
#   5. デフォルト設定 (組み込み)

# 別の TOML 設定ファイルを継承・分割して読み込む場合に指定（相対パスまたは絶対パス）
# include = "base.toml"

[features]
multiplexer_mode = false
# 左Drawerの表示モード: "always" (常時表示) / "collapsed" (折りたたみ) / "hidden" (非表示)
left_drawer_mode = "collapsed"
right_drawer = true
right_drawer_default_open = false
embedded_browser = true
kitty_graphics = true
copy_on_select = true

[appearance]
font_families = ["Cica", "FiraCode Nerd Font", "Fira Code"]
font_size = 18.0
font_thicken = true
adjust_cell_height = 2.0
# プリセット: "TokyoNight Moon" / "TokyoNight" / "Solarized Dark"
theme = "TokyoNight Moon"
background_opacity = 1.0
window_padding_x = 10.0
window_padding_y = 10.0
window_padding_balance = true

# テーマ色を個別に上書きしたい場合のみ指定（#RRGGBB 形式）
# [theme]
# background = "#222436"
# foreground = "#c8d3f5"
# accent = "#7aa2f7"
# drawer_background = "#1e2030"
# card_background = "#2f334d"
# cursor = "#82aaff"

[keybinds]
prefix = "ctrl+b"
new_tab = "ctrl+t"
new_workspace = "prefix+w"
split_right = "prefix+v"
split_down = "prefix+-"
toggle_zoom = "ctrl+shift+z"
pane_mode = "prefix+h"
pane_move_mode = "ctrl+shift+h"
pane_resize_mode = "prefix+r"
goto_left = "performable:ctrl+h"
goto_down = "performable:ctrl+j"
goto_up = "performable:ctrl+k"
goto_right = "performable:ctrl+l"
toggle_left_drawer = "prefix+b"
toggle_right_drawer = "ctrl+shift+g"
go_to = "prefix+g"
go_to_next = "j, down, ctrl+j, ctrl+n"
go_to_prev = "k, up, ctrl+k, ctrl+p"
go_to_select = "enter"
go_to_close = "esc, q"
go_to_filter = "/"
copy = "ctrl+shift+c"
paste = "ctrl+v"
reload_config = "ctrl+shift+r"
keybind_hints = "prefix+?"

[shell]
# Windows で起動するデフォルトシェル（既定値: ["powershell.exe"]）
windows_default_prog = ["powershell.exe"]

[window]
# ウィンドウ状態保存ポリシー（例: "always"）
save_state = "always"
# 分割・フォーカス移動時のズーム維持（例: "navigation"）
split_preserve_zoom = "navigation"
# macOS で Option キーを Alt として扱う設定: "left" / "none"
macos_option_as_alt = "left"

# 右Drawer プラグイン設定（Rust / Go / Zig 等のシングルバイナリを stdio JSON で呼び出す）
# category: "tasks" | "docs" | "chat" | "calendar" | "other"
# バイナリ探索順: conductty と同フォルダ -> ~/.config/conductty/plugins/ -> ~/.local/bin -> ~/.cargo/bin -> PATH
[[plugins]]
id = "github"
name = "GitHub"
category = "tasks"
command = "conductty-plugin-github"
args = []
enabled = true

[plugins.config]
limit = 15

[[plugins]]
id = "docs"
name = "Docs"
category = "docs"
command = "conductty-plugin-docs"
args = []
enabled = true

[plugins.config]
# デフォルトのメモ保存先ディレクトリ（未設定時は ~/notes を自動作成）
default_dir = "~/notes"
dirs = ["~/work/obsidian_git/", "./docs"]
limit = 30

# OS 別の条件分岐上書き（1 つの config.conductty 内で OS ごとに一部だけ変えたい場合）
# [os.macos.appearance]
# font_size = 16.0
#
[os.windows.appearance]
background_opacity = 0.8

# Windows でデフォルトシェルに WSL2 を使う設定（不要な場合はコメントアウト）
[os.windows.shell]
windows_default_prog = ["wsl.exe", "--cd", "~"]
#
# [os.linux.features]
# embedded_browser = false
#
# # WSL では [os.linux.*] の後に [os.wsl.*] が重ねて適用される
# [os.wsl.appearance]
# background_opacity = 1.0
